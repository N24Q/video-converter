{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug main process",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "args": ["."],
      "env": { "ELECTRON_RUN_AS_NODE": "" },
      "preLaunchTask": "npm: build",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist-electron/**/*.js"]
    }
  ]
}
